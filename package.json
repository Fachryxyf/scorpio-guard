{
  "name": "@fachryxyf/scorpio-guard",
  "version": "0.0.0",
  "description": "Adaptive trust evaluation for web interactions — a local, advisory library.",
  "license": "MIT",
  "author": "Fachryxyf",
  "repository": "github:Fachryxyf/scorpio-guard",
  "homepage": "https://scorpio-guard.fachryxyf.com",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collect": {
      "types": "./dist/collect/index.d.ts",
      "default": "./dist/collect/index.js"
    },
    "./sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "default": "./dist/store/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"examples/**/*.test.ts\"",
    "replay": "node --experimental-strip-types scripts/replay.mjs",
    "observe": "node --experimental-strip-types examples/ixfe/live/proxy.ts",
    "visitors": "node --experimental-strip-types examples/ixfe/live/visitors.ts",
    "observed": "node --experimental-strip-types examples/ixfe/live/report.ts",
    "smoke": "node scripts/smoke.mjs",
    "site": "node site/build.mjs",
    "site:check": "node site/build.mjs --check"
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
