{
  "name": "@fachryxyf/scorpio-guard",
  "version": "0.2.0",
  "description": "Adaptive trust evaluation for web interactions, as a local advisory library.",
  "license": "MIT",
  "author": "Fachryxyf",
  "repository": "github:Fachryxyf/scorpio-guard",
  "homepage": "https://scorpio-guard.fachryxyf.com",
  "bugs": "https://github.com/Fachryxyf/scorpio-guard/issues",
  "keywords": [
    "adaptive-trust",
    "abuse-prevention",
    "rate-limiting",
    "trust",
    "advisory",
    "zero-dependency"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collect": {
      "types": "./dist/collect/index.d.ts",
      "default": "./dist/collect/index.js"
    },
    "./sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "default": "./dist/store/sqlite.js"
    },
    "./kv": {
      "types": "./dist/store/kv.d.ts",
      "default": "./dist/store/kv.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"examples/**/*.test.ts\"",
    "replay": "node --experimental-strip-types scripts/replay.mjs",
    "observe": "node --experimental-strip-types examples/ixfe/live/proxy.ts",
    "visitors": "node --experimental-strip-types examples/ixfe/live/visitors.ts",
    "observed": "node --experimental-strip-types examples/ixfe/live/report.ts",
    "lab": "node --experimental-strip-types examples/lab/run.ts",
    "calibrate": "node --experimental-strip-types scripts/calibrate.mjs",
    "report:lab": "node --experimental-strip-types scripts/lab-report.mjs",
    "freeze:lab": "node --experimental-strip-types scripts/freeze-lab.mjs",
    "poison": "node --experimental-strip-types scripts/poison.mjs",
    "protocol:serve": "node --experimental-strip-types examples/protocol/server.ts",
    "protocol:check": "node --experimental-strip-types --test examples/protocol/interop.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "example:integration": "node --experimental-strip-types examples/integration/server.ts --demo",
    "site": "node site/build.mjs",
    "site:check": "node site/build.mjs --check",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:claims": "node scripts/claim-index.mjs --check",
    "check:api": "node scripts/api-surface.mjs --check",
    "claims": "node scripts/claim-index.mjs",
    "api": "node scripts/api-surface.mjs",
    "bench": "node --experimental-strip-types scripts/bench.mjs",
    "soak": "node --expose-gc --experimental-strip-types scripts/soak.mjs",
    "soak:flood": "node --expose-gc --experimental-strip-types scripts/soak.mjs --profile=flood",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.18.11",
    "express": "^5.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
